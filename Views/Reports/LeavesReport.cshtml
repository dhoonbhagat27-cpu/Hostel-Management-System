@model IEnumerable<HostelEase.Models.LeaveRequest>
@{
    ViewData["Title"] = "Leave Requests Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Student Leave & Absence Report</h4>
        <p class="text-muted small mb-0">Record of outstation leaves and authorized gate permissions</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportCsv" asp-route-type="leaves" class="btn btn-outline-success btn-sm">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export CSV
        </a>
        <button onclick="window.print()" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-printer me-1"></i> Print
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">All Reports</a>
    </div>
</div>

<div class="card card-custom">
    <div class="table-responsive">
        <table class="table table-custom">
            <thead>
                <tr>
                    <th>Leave ID</th>
                    <th>Resident Student</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Days</th>
                    <th>Destination</th>
                    <th>Emergency Contact</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in Model)
                {
                    <tr>
                        <td class="font-monospace">#@l.Id</td>
                        <td>@l.Student?.FullName (@l.Student?.StudentId)</td>
                        <td class="small">@l.StartDate.ToString("dd MMM yyyy")</td>
                        <td class="small">@l.EndDate.ToString("dd MMM yyyy")</td>
                        <td class="small fw-bold">@((l.EndDate.Date - l.StartDate.Date).Days + 1)</td>
                        <td class="small">@l.Destination</td>
                        <td class="small font-monospace">@l.EmergencyContact</td>
                        <td>
                            <span class="badge @(l.Status == "Approved" ? "bg-success" : l.Status == "Rejected" ? "bg-danger" : "bg-warning text-dark")">
                                @l.Status
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
