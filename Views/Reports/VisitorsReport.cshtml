@model IEnumerable<HostelEase.Models.Visitor>
@{
    ViewData["Title"] = "Visitors Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Campus Visitors & Security Report</h4>
        <p class="text-muted small mb-0">Complete log of all visitors, entry and departure times, and purpose of visit</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportCsv" asp-route-type="visitors" class="btn btn-outline-success btn-sm">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export CSV
        </a>
        <button onclick="window.print()" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-printer me-1"></i> Print
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">All Reports</a>
    </div>
</div>

<div class="card card-custom">
    <div class="table-responsive">
        <table class="table table-custom">
            <thead>
                <tr>
                    <th>Visitor Name</th>
                    <th>Contact Phone</th>
                    <th>Relation</th>
                    <th>Resident Visited</th>
                    <th>Entry Timestamp</th>
                    <th>Exit Timestamp</th>
                    <th>Purpose of Visit</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model)
                {
                    <tr>
                        <td class="fw-bold text-dark">@v.VisitorName</td>
                        <td class="small font-monospace">@v.ContactNumber</td>
                        <td><span class="badge bg-light text-dark border">@v.RelationToStudent</span></td>
                        <td>@v.Student?.FullName (@v.Student?.StudentId)</td>
                        <td class="small text-muted">@v.EntryTime.ToString("dd MMM yyyy, hh:mm tt")</td>
                        <td class="small text-muted">
                            @(v.ExitTime.HasValue ? v.ExitTime.Value.ToString("dd MMM yyyy, hh:mm tt") : "Not recorded")
                        </td>
                        <td class="small text-secondary">@v.PurposeOfVisit</td>
                        <td>
                            @if (v.ExitTime.HasValue)
                            {
                                <span class="badge-status badge-active">Completed</span>
                            }
                            else
                            {
                                <span class="badge-status badge-occupied">Currently Inside</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
