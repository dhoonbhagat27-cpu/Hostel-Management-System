@model IEnumerable<HostelEase.Models.FeePayment>
@{
    ViewData["Title"] = "Fee Collection Report";
    var totalSum = Model.Sum(p => p.Amount);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Fee Collection & Revenue Report</h4>
        <p class="text-muted small mb-0">Audited payment collection registers with payment modes</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportCsv" asp-route-type="fees" class="btn btn-outline-success btn-sm">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export CSV
        </a>
        <button onclick="window.print()" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-printer me-1"></i> Print
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">All Reports</a>
    </div>
</div>

<div class="card card-custom p-3 mb-3 bg-light">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <span class="text-muted small fw-semibold text-uppercase">Total Amount In this Report:</span>
            <div class="fw-bold fs-4 text-success">₹@totalSum.ToString("N2")</div>
        </div>
        <div class="text-muted small">@Model.Count() Transactions Listed</div>
    </div>
</div>

<div class="card card-custom">
    <div class="table-responsive">
        <table class="table table-custom">
            <thead>
                <tr>
                    <th>Receipt #</th>
                    <th>Student Name</th>
                    <th>Student ID</th>
                    <th>Fee Description</th>
                    <th>Payment Mode</th>
                    <th>Transaction Reference</th>
                    <th>Payment Date</th>
                    <th>Amount Paid</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="fw-bold font-monospace text-primary">@p.ReceiptNumber</td>
                        <td>@p.StudentFee?.Student?.FullName</td>
                        <td class="small font-monospace">@p.StudentFee?.Student?.StudentId</td>
                        <td class="small">@p.StudentFee?.FeeTitle</td>
                        <td><span class="badge bg-light text-dark border">@p.PaymentMethod</span></td>
                        <td class="small font-monospace text-muted">@p.TransactionReference</td>
                        <td class="small">@p.PaymentDate.ToString("dd MMM yyyy")</td>
                        <td class="fw-bold text-success text-end">₹@p.Amount.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
