@model IEnumerable<HostelEase.Models.Room>
@{
    ViewData["Title"] = "Occupancy Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Hostel Occupancy & Bed Utilization Report</h4>
        <p class="text-muted small mb-0">Detailed occupancy distribution by hostel, floor, and room</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportCsv" asp-route-type="occupancy" class="btn btn-outline-success btn-sm">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export CSV
        </a>
        <button onclick="window.print()" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-printer me-1"></i> Print Report
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">All Reports</a>
    </div>
</div>

<div class="card card-custom">
    <div class="table-responsive">
        <table class="table table-custom">
            <thead>
                <tr>
                    <th>Hostel Building</th>
                    <th>Room #</th>
                    <th>Floor</th>
                    <th>Room Type</th>
                    <th>Capacity</th>
                    <th>Occupied Beds</th>
                    <th>Available Beds</th>
                    <th>Occupancy %</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    var occ = r.Beds.Count(b => b.Status == "Occupied");
                    var avail = r.Beds.Count(b => b.Status == "Available");
                    var rate = r.Capacity > 0 ? Math.Round(((double)occ / r.Capacity) * 100, 1) : 0;
                    <tr>
                        <td class="fw-semibold">@r.Hostel?.Name</td>
                        <td class="fw-bold text-dark">Room @r.RoomNumber</td>
                        <td>Floor @r.Floor</td>
                        <td>@r.RoomType</td>
                        <td>@r.Capacity</td>
                        <td class="fw-bold text-primary">@occ</td>
                        <td class="fw-bold text-success">@avail</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="small fw-semibold">@rate%</span>
                                <div class="progress flex-grow-1" style="height: 5px; width: 60px;">
                                    <div class="progress-bar @(occ >= r.Capacity ? "bg-danger" : "bg-primary")" role="progressbar" style="width: @rate%"></div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="badge-status @(r.Status == "Available" ? "badge-available" : r.Status == "Full" ? "badge-full" : "badge-maintenance")">
                                @r.Status
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
