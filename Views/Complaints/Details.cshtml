@model HostelEase.Models.Complaint
@{
    ViewData["Title"] = $"Complaint #{Model.Id}";
    var activeAlloc = Model.Student?.Allocations.FirstOrDefault();
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-custom">
            <div class="card-header-custom">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-tools text-primary fs-4"></i>
                    <div>
                        <h5 class="mb-0 fw-bold">Ticket #@Model.Id: @Model.Subject</h5>
                        <small class="text-muted">Filed on @Model.SubmissionDate.ToString("dd MMM yyyy, hh:mm tt")</small>
                    </div>
                </div>
                <span class="badge-status @(Model.Status == "Resolved" ? "badge-resolved" : Model.Status == "In Progress" ? "badge-in-progress" : "badge-submitted")">
                    @Model.Status
                </span>
            </div>

            <div class="card-body">
                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label class="text-muted small fw-semibold text-uppercase">Resident Student</label>
                        <div class="fw-bold">@Model.Student?.FullName (@Model.Student?.StudentId)</div>
                        <div class="small text-muted">@Model.Student?.PhoneNumber &middot; @Model.Student?.Email</div>
                    </div>

                    <div class="col-md-6">
                        <label class="text-muted small fw-semibold text-uppercase">Accommodation Location</label>
                        @if (activeAlloc?.Bed?.Room != null)
                        {
                            <div class="fw-bold">Room @activeAlloc.Bed.Room.RoomNumber [Bed @activeAlloc.Bed.BedNumber]</div>
                            <div class="small text-muted">@activeAlloc.Bed.Room.Hostel?.Name</div>
                        }
                        else
                        {
                            <div class="text-muted small">No active room assignment</div>
                        }
                    </div>

                    <div class="col-md-4">
                        <label class="text-muted small fw-semibold text-uppercase">Category</label>
                        <div><span class="badge bg-light text-dark border">@Model.Category</span></div>
                    </div>

                    <div class="col-md-4">
                        <label class="text-muted small fw-semibold text-uppercase">Priority</label>
                        <div>
                            <span class="badge @(Model.Priority == "Urgent" ? "bg-danger" : Model.Priority == "High" ? "bg-warning text-dark" : "bg-info text-dark")">
                                @Model.Priority
                            </span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label class="text-muted small fw-semibold text-uppercase">Assigned Staff</label>
                        <div class="fw-bold">@(Model.AssignedStaff?.FullName ?? "Unassigned")</div>
                    </div>

                    <div class="col-12">
                        <label class="text-muted small fw-semibold text-uppercase">Problem Description</label>
                        <div class="p-3 bg-light rounded-3 border text-secondary">
                            @Model.Description
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="text-muted small fw-semibold text-uppercase">Resolution Remarks & Progress</label>
                        <div class="p-3 bg-light rounded-3 border">
                            @if (!string.IsNullOrEmpty(Model.ResolutionRemarks))
                            {
                                <div class="fw-semibold text-dark mb-1">@Model.ResolutionRemarks</div>
                                @if (Model.ResolvedDate.HasValue)
                                {
                                    <div class="text-muted small">Resolved Date: @Model.ResolvedDate.Value.ToString("dd MMM yyyy, hh:mm tt")</div>
                                }
                            }
                            else
                            {
                                <span class="text-muted fst-italic">No administrative resolution remarks added yet.</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 border-top pt-3">
                    <a asp-action="Resolve" asp-route-id="@Model.Id" class="btn btn-primary-custom btn-sm">
                        <i class="bi bi-pencil me-1"></i> Update Status / Resolve
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Complaints</a>
                </div>
            </div>
        </div>
    </div>
</div>
