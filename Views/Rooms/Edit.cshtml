@model HostelEase.Models.Room
@{
    ViewData["Title"] = "Edit Room";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card card-custom">
            <div class="card-header-custom">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-pencil-square text-primary fs-4"></i>
                    <div>
                        <h5 class="mb-0 fw-bold">Edit Room @Model.RoomNumber</h5>
                        <small class="text-muted">Update specifications and monthly fees</small>
                    </div>
                </div>
            </div>

            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="HostelId" class="form-label small fw-semibold text-secondary"></label>
                            <select asp-for="HostelId" class="form-select" asp-items="ViewBag.Hostels"></select>
                            <span asp-validation-for="HostelId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="RoomNumber" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="RoomNumber" class="form-control" />
                            <span asp-validation-for="RoomNumber" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Floor" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="Floor" type="number" min="0" max="20" class="form-control" />
                            <span asp-validation-for="Floor" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="RoomType" class="form-label small fw-semibold text-secondary"></label>
                            <select asp-for="RoomType" class="form-select">
                                <option value="Single">Single</option>
                                <option value="Double">Double</option>
                                <option value="Triple">Triple</option>
                                <option value="Four-Sharing">Four-Sharing</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Capacity" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="Capacity" type="number" min="1" max="10" class="form-control" />
                            <span asp-validation-for="Capacity" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MonthlyFee" class="form-label small fw-semibold text-secondary"></label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input asp-for="MonthlyFee" type="number" step="0.01" class="form-control" />
                            </div>
                            <span asp-validation-for="MonthlyFee" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label small fw-semibold text-secondary"></label>
                            <select asp-for="Status" class="form-select">
                                <option value="Available">Available</option>
                                <option value="Full">Full</option>
                                <option value="Maintenance">Maintenance</option>
                                <option value="Inactive">Inactive</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label small fw-semibold text-secondary"></label>
                            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                        </div>

                        <div class="col-12 mt-4 d-flex gap-2">
                            <button type="submit" class="btn btn-primary-custom flex-grow-1">Save Changes</button>
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
