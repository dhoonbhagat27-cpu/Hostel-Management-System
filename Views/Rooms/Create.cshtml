@model HostelEase.Models.Room
@{
    ViewData["Title"] = "Add Room";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card card-custom">
            <div class="card-header-custom">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-door-open-fill text-primary fs-4"></i>
                    <div>
                        <h5 class="mb-0 fw-bold">Create Room</h5>
                        <small class="text-muted">Register room with optional automatic bed generation</small>
                    </div>
                </div>
            </div>

            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="HostelId" class="form-label small fw-semibold text-secondary"></label>
                            <select asp-for="HostelId" class="form-select" asp-items="ViewBag.Hostels"></select>
                            <span asp-validation-for="HostelId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="RoomNumber" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="RoomNumber" class="form-control" placeholder="e.g. 101, 204" />
                            <span asp-validation-for="RoomNumber" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Floor" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="Floor" type="number" min="0" max="20" class="form-control" />
                            <span asp-validation-for="Floor" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="RoomType" class="form-label small fw-semibold text-secondary"></label>
                            <select asp-for="RoomType" class="form-select" id="roomTypeSelect">
                                <option value="Single">Single (1 Bed)</option>
                                <option value="Double" selected>Double (2 Beds)</option>
                                <option value="Triple">Triple (3 Beds)</option>
                                <option value="Four-Sharing">Four-Sharing (4 Beds)</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Capacity" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="Capacity" type="number" min="1" max="10" class="form-control" id="capacityInput" />
                            <span asp-validation-for="Capacity" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MonthlyFee" class="form-label small fw-semibold text-secondary"></label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input asp-for="MonthlyFee" type="number" step="0.01" class="form-control" />
                            </div>
                            <span asp-validation-for="MonthlyFee" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label small fw-semibold text-secondary"></label>
                            <select asp-for="Status" class="form-select">
                                <option value="Available">Available</option>
                                <option value="Maintenance">Maintenance</option>
                                <option value="Inactive">Inactive</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label small fw-semibold text-secondary"></label>
                            <textarea asp-for="Description" class="form-control" rows="2" placeholder="Balcony view, attached washroom, quiet corner..."></textarea>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input type="checkbox" name="autoCreateBeds" value="true" class="form-check-input" id="autoBeds" checked />
                                <label class="form-check-label small fw-semibold" for="autoBeds">
                                    Auto-create individual beds for this capacity (e.g. 101-A, 101-B)
                                </label>
                            </div>
                        </div>

                        <div class="col-12 mt-4 d-flex gap-2">
                            <button type="submit" class="btn btn-primary-custom flex-grow-1">Create Room</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('roomTypeSelect').addEventListener('change', function () {
            const val = this.value;
            const cap = document.getElementById('capacityInput');
            if (val === 'Single') cap.value = 1;
            else if (val === 'Double') cap.value = 2;
            else if (val === 'Triple') cap.value = 3;
            else if (val === 'Four-Sharing') cap.value = 4;
        });
    </script>
}
