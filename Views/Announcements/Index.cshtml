@model IEnumerable<HostelEase.Models.Announcement>
@{
    ViewData["Title"] = "Announcements";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Hostel Notices & Circulars</h4>
        <p class="text-muted small mb-0">Publish and manage notices for residents and staff</p>
    </div>
    <a asp-action="Create" class="btn btn-primary-custom btn-sm">
        <i class="bi bi-megaphone-fill me-1"></i> Publish Announcement
    </a>
</div>

<div class="card card-custom">
    <div class="table-responsive">
        <table class="table table-custom">
            <thead>
                <tr>
                    <th>Title & Content</th>
                    <th>Audience</th>
                    <th>Priority</th>
                    <th>Published On</th>
                    <th>Expires</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var ann in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">@ann.Title</div>
                                <div class="small text-secondary text-truncate" style="max-width: 320px;">@ann.Content</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @(ann.Hostel != null ? ann.Hostel.Name : ann.TargetAudience)
                                </span>
                            </td>
                            <td>
                                <span class="badge @(ann.Priority == "Urgent" ? "bg-danger" : ann.Priority == "Important" ? "bg-warning text-dark" : "bg-primary")">
                                    @ann.Priority
                                </span>
                            </td>
                            <td class="small text-muted">@ann.PublishDate.ToString("dd MMM yyyy")</td>
                            <td class="small text-muted">@(ann.ExpiryDate.HasValue ? ann.ExpiryDate.Value.ToString("dd MMM yyyy") : "Never")</td>
                            <td>
                                <span class="badge-status @(ann.IsActive ? "badge-active" : "badge-inactive")">
                                    @(ann.IsActive ? "Active" : "Archived")
                                </span>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <form asp-action="Toggle" asp-route-id="@ann.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-outline-secondary py-0 px-2" title="Toggle Active">
                                            @(ann.IsActive ? "Archive" : "Activate")
                                        </button>
                                    </form>
                                    <form asp-action="Delete" asp-route-id="@ann.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this announcement permanently?');">
                                        <button type="submit" class="btn btn-outline-danger py-0 px-2" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No announcements published.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
