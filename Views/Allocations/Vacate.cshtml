@model HostelEase.ViewModels.VacateBedViewModel
@{
    ViewData["Title"] = "Vacate Bed Allocation";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card card-custom">
            <div class="card-header-custom bg-danger-subtle">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-box-arrow-right text-danger fs-4"></i>
                    <div>
                        <h5 class="mb-0 fw-bold text-danger">Vacate Bed & Check-Out Clearance</h5>
                        <small class="text-muted">Process departure, room handover, and release bed</small>
                    </div>
                </div>
            </div>

            <div class="card-body">
                <div class="p-3 bg-light rounded-3 border mb-4">
                    <div class="row g-2 small">
                        <div class="col-6"><span class="text-muted">Student:</span> <strong>@Model.StudentName</strong></div>
                        <div class="col-6"><span class="text-muted">Hostel:</span> <strong>@Model.HostelName</strong></div>
                        <div class="col-6"><span class="text-muted">Room & Bed:</span> <strong>Room @Model.RoomNumber &middot; Bed @Model.BedNumber</strong></div>
                        <div class="col-6"><span class="text-muted">Allocated On:</span> <strong>@Model.AllocationDate.ToString("dd MMM yyyy")</strong></div>
                    </div>
                </div>

                <form asp-action="Vacate" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                    <input type="hidden" asp-for="AllocationId" />
                    <input type="hidden" asp-for="StudentName" />
                    <input type="hidden" asp-for="BedNumber" />
                    <input type="hidden" asp-for="RoomNumber" />
                    <input type="hidden" asp-for="HostelName" />
                    <input type="hidden" asp-for="AllocationDate" />

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="ActualVacatingDate" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="ActualVacatingDate" type="date" class="form-control" />
                            <span asp-validation-for="ActualVacatingDate" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Remarks" class="form-label small fw-semibold text-secondary"></label>
                            <textarea asp-for="Remarks" class="form-control" rows="3" placeholder="Key return confirmed, room inspection completed, dues settled..."></textarea>
                        </div>

                        <div class="col-12 mt-4 d-flex gap-2">
                            <button type="submit" class="btn btn-danger flex-grow-1" onclick="return confirm('Confirm check-out? Bed will immediately become available for new allocation.');">
                                <i class="bi bi-box-arrow-right me-1"></i> Confirm Check-out & Vacate
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
