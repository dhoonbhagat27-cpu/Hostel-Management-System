@model HostelEase.ViewModels.TransferBedViewModel
@{
    ViewData["Title"] = "Transfer Bed Allocation";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card card-custom">
            <div class="card-header-custom">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-arrow-left-right text-primary fs-4"></i>
                    <div>
                        <h5 class="mb-0 fw-bold">Transfer Bed Allocation</h5>
                        <small class="text-muted">Reassign resident to a new room and bed</small>
                    </div>
                </div>
            </div>

            <div class="card-body">
                <!-- Current Assignment Summary -->
                <div class="p-3 bg-light rounded-3 border mb-4">
                    <h6 class="fw-bold text-dark small text-uppercase mb-2">Current Allocation Details:</h6>
                    <div class="row g-2 small">
                        <div class="col-md-6">
                            <span class="text-muted">Student:</span> <strong>@Model.StudentName (@Model.StudentIdString)</strong>
                        </div>
                        <div class="col-md-6">
                            <span class="text-muted">Hostel:</span> <strong>@Model.CurrentHostelName</strong>
                        </div>
                        <div class="col-md-6">
                            <span class="text-muted">Current Room:</span> <strong>Room @Model.CurrentRoomNumber</strong>
                        </div>
                        <div class="col-md-6">
                            <span class="text-muted">Current Bed:</span> <strong class="text-primary">Bed @Model.CurrentBedNumber</strong>
                        </div>
                    </div>
                </div>

                <form asp-action="Transfer" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                    <input type="hidden" asp-for="CurrentAllocationId" />
                    <input type="hidden" asp-for="StudentName" />
                    <input type="hidden" asp-for="StudentIdString" />
                    <input type="hidden" asp-for="CurrentBedNumber" />
                    <input type="hidden" asp-for="CurrentRoomNumber" />
                    <input type="hidden" asp-for="CurrentHostelName" />

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="NewBedId" class="form-label small fw-semibold text-secondary"></label>
                            <select asp-for="NewBedId" class="form-select" asp-items="Model.AvailableBedsList">
                                <option value="">-- Select Target Bed --</option>
                            </select>
                            <span asp-validation-for="NewBedId" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Remarks" class="form-label small fw-semibold text-secondary"></label>
                            <textarea asp-for="Remarks" class="form-control" rows="3" placeholder="Reason for transfer (Room change request, medical necessity, noise issues)..."></textarea>
                        </div>

                        <div class="col-12 mt-4 d-flex gap-2">
                            <button type="submit" class="btn btn-primary-custom flex-grow-1">
                                <i class="bi bi-arrow-repeat me-1"></i> Confirm Bed Transfer
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
