@using Microsoft.AspNetCore.Identity
@using HostelEase.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HostelEase</title>
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Custom Theme CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>

@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    var userRole = User.IsInRole("Admin") ? "Admin" : User.IsInRole("Warden") ? "Warden" : "Student";
    var initials = !string.IsNullOrEmpty(currentUser?.FullName) ? string.Join("", currentUser.FullName.Split(' ').Select(n => n[0])).ToUpper() : "U";
    if (initials.Length > 2) initials = initials.Substring(0, 2);

    <div class="app-wrapper">
        <!-- Sidebar Navigation -->
        <aside class="app-sidebar" id="appSidebar">
            <a asp-controller="Home" asp-action="Index" class="sidebar-brand">
                <i class="bi bi-shield-heart-fill text-purple"></i> HostelEase
                <span class="badge bg-purple-subtle text-purple border ms-1" style="font-size: 0.65rem; background-color: #f3e8ff; color: #7e22ce; border-color: #d8b4fe !important;">Girls' Hostel</span>
            </a>

            <div class="sidebar-menu">
                @if (User.IsInRole("Admin"))
                {
                    <div class="menu-category">Main</div>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")" 
                       asp-controller="Admin" asp-action="Dashboard">
                        <i class="bi bi-grid-1x2-fill"></i> Admin Dashboard
                    </a>

                    <div class="menu-category">Hostel & Living</div>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Hostels" ? "active" : "")" 
                       asp-controller="Hostels" asp-action="Index">
                        <i class="bi bi-building"></i> Hostels
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Rooms" ? "active" : "")" 
                       asp-controller="Rooms" asp-action="Index">
                        <i class="bi bi-door-open"></i> Rooms & Beds
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Allocations" ? "active" : "")" 
                       asp-controller="Allocations" asp-action="Index">
                        <i class="bi bi-person-check-fill"></i> Bed Allocations
                    </a>

                    <div class="menu-category">People Management</div>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Students" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" 
                       asp-controller="Students" asp-action="Index">
                        <i class="bi bi-mortarboard-fill"></i> Students Directory
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Students" && ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active" : "")" 
                       asp-controller="Students" asp-action="Create">
                        <i class="bi bi-person-plus-fill"></i> Register Student Name
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() == "Staff" ? "active" : "")" 
                       asp-controller="Admin" asp-action="Staff">
                        <i class="bi bi-person-badge"></i> Wardens & Staff
                    </a>

                    <div class="menu-category">Finance</div>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Fees" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" 
                       asp-controller="Fees" asp-action="Index">
                        <i class="bi bi-cash-stack"></i> Fee Obligations
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Fees" && ViewContext.RouteData.Values["action"]?.ToString() == "Payments" ? "active" : "")" 
                       asp-controller="Fees" asp-action="Payments">
                        <i class="bi bi-receipt"></i> Payment Records
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Fees" && ViewContext.RouteData.Values["action"]?.ToString() == "Structures" ? "active" : "")" 
                       asp-controller="Fees" asp-action="Structures">
                        <i class="bi bi-tags-fill"></i> Fee Structures
                    </a>

                    <div class="menu-category">Operations</div>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Complaints" ? "active" : "")" 
                       asp-controller="Complaints" asp-action="Index">
                        <i class="bi bi-tools"></i> Complaints
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Leave" ? "active" : "")" 
                       asp-controller="Leave" asp-action="Index">
                        <i class="bi bi-calendar2-week"></i> Leave Requests
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Visitors" ? "active" : "")" 
                       asp-controller="Visitors" asp-action="Index">
                        <i class="bi bi-person-walking"></i> Visitor Gate Pass
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Announcements" ? "active" : "")" 
                       asp-controller="Announcements" asp-action="Index">
                        <i class="bi bi-megaphone-fill"></i> Announcements
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")" 
                       asp-controller="Reports" asp-action="Index">
                        <i class="bi bi-bar-chart-line-fill"></i> Reports & Analytics
                    </a>

                    <div class="menu-category">System</div>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() == "Users" ? "active" : "")" 
                       asp-controller="Admin" asp-action="Users">
                        <i class="bi bi-shield-lock-fill"></i> User Accounts
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() == "AuditLogs" ? "active" : "")" 
                       asp-controller="Admin" asp-action="AuditLogs">
                        <i class="bi bi-journal-text"></i> Audit Logs
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() == "Settings" ? "active" : "")" 
                       asp-controller="Admin" asp-action="Settings">
                        <i class="bi bi-gear-fill"></i> Settings
                    </a>
                }
                else if (User.IsInRole("Warden"))
                {
                    <div class="menu-category">Warden Desk</div>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Warden" && ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")" 
                       asp-controller="Warden" asp-action="Dashboard">
                        <i class="bi bi-speedometer2"></i> Warden Dashboard
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Warden" && ViewContext.RouteData.Values["action"]?.ToString() == "AssignedHostel" ? "active" : "")" 
                       asp-controller="Warden" asp-action="AssignedHostel">
                        <i class="bi bi-building"></i> Assigned Hostel
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Warden" && ViewContext.RouteData.Values["action"]?.ToString() == "Students" ? "active" : "")" 
                       asp-controller="Warden" asp-action="Students">
                        <i class="bi bi-people-fill"></i> Hostel Students
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Students" && ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active" : "")" 
                       asp-controller="Students" asp-action="Create">
                        <i class="bi bi-person-plus-fill"></i> Direct Student Admission
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Warden" && ViewContext.RouteData.Values["action"]?.ToString() == "RoomAvailability" ? "active" : "")" 
                       asp-controller="Warden" asp-action="RoomAvailability">
                        <i class="bi bi-door-open-fill"></i> Bed Availability
                    </a>

                    <div class="menu-category">Hostel Supervision</div>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Leave" ? "active" : "")" 
                       asp-controller="Leave" asp-action="Index">
                        <i class="bi bi-calendar2-check-fill"></i> Leave Approvals
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Complaints" ? "active" : "")" 
                       asp-controller="Complaints" asp-action="Index">
                        <i class="bi bi-tools"></i> Complaints & Repairs
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Visitors" ? "active" : "")" 
                       asp-controller="Visitors" asp-action="Index">
                        <i class="bi bi-person-badge-fill"></i> Visitor Entry / Exit
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Announcements" ? "active" : "")" 
                       asp-controller="Announcements" asp-action="Index">
                        <i class="bi bi-megaphone-fill"></i> Notice Board
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")" 
                       asp-controller="Reports" asp-action="Index">
                        <i class="bi bi-clipboard-data-fill"></i> Hostel Reports
                    </a>
                }
                else
                {
                    <div class="menu-category">Student Portal</div>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Student" && ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")" 
                       asp-controller="Student" asp-action="Dashboard">
                        <i class="bi bi-grid-1x2-fill"></i> Student Dashboard
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Student" && ViewContext.RouteData.Values["action"]?.ToString() == "MyRoom" ? "active" : "")" 
                       asp-controller="Student" asp-action="MyRoom">
                        <i class="bi bi-door-closed-fill"></i> My Room & Bed
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Student" && ViewContext.RouteData.Values["action"]?.ToString() == "MyFees" ? "active" : "")" 
                       asp-controller="Student" asp-action="MyFees">
                        <i class="bi bi-wallet2"></i> My Fees
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Student" && ViewContext.RouteData.Values["action"]?.ToString() == "PaymentHistory" ? "active" : "")" 
                       asp-controller="Student" asp-action="PaymentHistory">
                        <i class="bi bi-receipt"></i> Payment Receipts
                    </a>

                    <div class="menu-category">Requests & Services</div>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Student" && ViewContext.RouteData.Values["action"]?.ToString() == "MyComplaints" ? "active" : "")" 
                       asp-controller="Student" asp-action="MyComplaints">
                        <i class="bi bi-tools"></i> My Complaints
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Student" && ViewContext.RouteData.Values["action"]?.ToString() == "SubmitComplaint" ? "active" : "")" 
                       asp-controller="Student" asp-action="SubmitComplaint">
                        <i class="bi bi-plus-circle"></i> File Complaint
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Student" && ViewContext.RouteData.Values["action"]?.ToString() == "MyLeaveRequests" ? "active" : "")" 
                       asp-controller="Student" asp-action="MyLeaveRequests">
                        <i class="bi bi-calendar2-range"></i> My Leaves
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Student" && ViewContext.RouteData.Values["action"]?.ToString() == "ApplyLeave" ? "active" : "")" 
                       asp-controller="Student" asp-action="ApplyLeave">
                        <i class="bi bi-send-fill"></i> Apply for Leave
                    </a>
                    <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Student" && ViewContext.RouteData.Values["action"]?.ToString() == "Announcements" ? "active" : "")" 
                       asp-controller="Student" asp-action="Announcements">
                        <i class="bi bi-broadcast"></i> Hostel Notices
                    </a>
                }
            </div>
        </aside>

        <!-- Main Wrapper -->
        <div class="app-content">
            <!-- Topbar -->
            <header class="app-topbar">
                <div class="topbar-left">
                    <button class="btn btn-sm btn-light border d-lg-none" id="sidebarToggleBtn" type="button">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <span class="badge bg-light text-primary border px-2 py-1 fs-7 fw-semibold">
                        <i class="bi bi-shield-check me-1"></i> @userRole Role
                    </span>
                </div>

                <div class="topbar-right">
                    <!-- Notification Bell -->
                    <a asp-controller="Notifications" asp-action="Index" class="notification-bell-btn" title="Notifications">
                        <i class="bi bi-bell"></i>
                        <span class="notification-badge d-none" id="notificationBadge">0</span>
                    </a>

                    <!-- User Dropdown -->
                    <div class="dropdown">
                        <button class="user-avatar-pill dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="avatar-circle">@initials</div>
                            <div class="d-none d-md-block text-start">
                                <div class="fw-semibold text-dark small">@(currentUser?.FullName ?? "User")</div>
                                <div class="text-muted" style="font-size: 0.72rem;">@currentUser?.Email</div>
                            </div>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border mt-2">
                            <li class="px-3 py-2 border-bottom">
                                <div class="fw-bold small">Signed in as</div>
                                <div class="text-muted small text-truncate">@currentUser?.Email</div>
                            </li>
                            <li><a class="dropdown-item py-2 small" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2"></i> My Profile</a></li>
                            <li><a class="dropdown-item py-2 small" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key me-2"></i> Change Password</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="dropdown-item py-2 small text-danger"><i class="bi bi-box-arrow-right me-2"></i> Sign Out</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Page Body -->
            <main class="main-container">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["InfoMessage"] != null)
                {
                    <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
                        <i class="bi bi-info-circle-fill me-2"></i> @TempData["InfoMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </main>

            <!-- Admin / Staff / Student Footer -->
            <footer class="bg-white border-top py-3 text-center text-muted small mt-auto no-print">
                <div class="container-fluid">
                    HostelEase – Girls' Hostel Management System &copy; 2026. Final Year B.Tech Computer Engineering Capstone Project.
                </div>
            </footer>
        </div>
    </div>
}
else
{
    <!-- Public Guest View Header -->
    <header class="bg-white border-bottom sticky-top shadow-sm">
        <nav class="navbar navbar-expand-lg navbar-light py-3">
            <div class="container">
                <a class="navbar-brand fw-bold text-dark fs-4" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-shield-heart-fill text-purple me-2"></i> HostelEase
                    <span class="badge bg-purple-subtle text-purple border ms-1" style="font-size: 0.7rem; background-color: #f3e8ff; color: #7e22ce; border-color: #d8b4fe !important;">Girls' Hostel</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#publicNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="publicNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                        <li class="nav-item">
                            <a class="nav-link fw-medium text-dark" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-medium text-dark" asp-controller="Home" asp-action="Features">Campus Amenities</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-medium text-dark" asp-controller="Home" asp-action="About">About Residence</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-medium text-dark" asp-controller="Home" asp-action="Contact">Security & Helpdesk</a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary-custom px-3">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Resident Sign In
                        </a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-primary-custom px-3" style="background: linear-gradient(135deg, #7e22ce 0%, #4f46e5 100%); border: none;">
                            <i class="bi bi-person-plus-fill me-1"></i> Resident Registration
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow-1">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="bg-white border-top py-4 text-center text-muted small mt-auto">
        <div class="container">
            <div class="row align-items-center gy-2">
                <div class="col-md-6 text-md-start">
                    <span class="fw-bold text-dark">HostelEase</span> – Final-Year B.Tech Computer Engineering Capstone Project.
                </div>
                <div class="col-md-6 text-md-end">
                    <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted me-3">Home</a>
                    <a asp-controller="Home" asp-action="Features" class="text-decoration-none text-muted me-3">Features</a>
                    <a asp-controller="Home" asp-action="Contact" class="text-decoration-none text-muted">Support</a>
                </div>
            </div>
        </div>
    </footer>
}

<!-- Core Scripts -->
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

<script>
    // Responsive sidebar toggle for mobile
    document.getElementById('sidebarToggleBtn')?.addEventListener('click', function() {
        document.getElementById('appSidebar')?.classList.toggle('show');
    });

    // Check unread notifications count
    @if (SignInManager.IsSignedIn(User))
    {
        <text>
        fetch('/Notifications/GetUnreadCount')
            .then(res => res.json())
            .then(data => {
                if (data && data.count > 0) {
                    const badge = document.getElementById('notificationBadge');
                    if (badge) {
                        badge.textContent = data.count;
                        badge.classList.remove('d-none');
                    }
                }
            })
            .catch(() => {});
        </text>
    }
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
