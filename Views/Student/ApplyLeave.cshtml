@model HostelEase.ViewModels.LeaveApplyViewModel
@{
    ViewData["Title"] = "Apply for Leave";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card card-custom">
            <div class="card-header-custom">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-calendar2-week-fill text-primary fs-4"></i>
                    <div>
                        <h5 class="mb-0 fw-bold">Outstation Leave / Gate Pass Application</h5>
                        <small class="text-muted">Apply for overnight or vacation leave permission</small>
                    </div>
                </div>
            </div>

            <div class="card-body">
                <div class="alert alert-light border small text-muted mb-3 py-2 px-3 rounded-3" style="background-color: #faf5ff; border-color: #e9d5ff !important;">
                    <i class="bi bi-shield-check text-purple me-2" style="color: #7e22ce;"></i>
                    <strong style="color: #7e22ce;">Parental Verification Protocol:</strong>
                    All outstation leaves and night-out gate passes are vetted by the Resident Warden. A telephonic or SMS confirmation with the registered parent or Local Guardian is required before digital gate clearance is activated.
                </div>

                <form asp-action="ApplyLeave" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="StartDate" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="StartDate" type="date" class="form-control" />
                            <span asp-validation-for="StartDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="EndDate" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="EndDate" type="date" class="form-control" />
                            <span asp-validation-for="EndDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Destination" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="Destination" class="form-control" placeholder="Destination City, State" />
                            <span asp-validation-for="Destination" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="EmergencyContact" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="EmergencyContact" class="form-control" placeholder="Parent / Guardian phone number" />
                            <span asp-validation-for="EmergencyContact" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Reason" class="form-label small fw-semibold text-secondary"></label>
                            <textarea asp-for="Reason" class="form-control" rows="3" placeholder="State reason for absence (Family event, medical leave, festival holiday, exam center)..."></textarea>
                            <span asp-validation-for="Reason" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <div class="form-check">
                                <input asp-for="ParentInformed" class="form-check-input" />
                                <label asp-for="ParentInformed" class="form-check-label small text-secondary"></label>
                            </div>
                        </div>

                        <div class="col-12 mt-4 d-flex gap-2">
                            <button type="submit" class="btn btn-primary-custom flex-grow-1">
                                <i class="bi bi-send-fill me-1"></i> Submit Leave Request
                            </button>
                            <a asp-action="MyLeaveRequests" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
