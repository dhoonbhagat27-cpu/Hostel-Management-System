@model HostelEase.Models.Student
@{
    ViewData["Title"] = $"Student Details - {Model.FullName}";
    var activeAlloc = Model.Allocations.FirstOrDefault(a => a.Status == "Active");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">@Model.FullName</h4>
        <p class="text-muted small mb-0">Student Enrollment: <strong>@Model.StudentId</strong> &middot; Department: @Model.Department</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary-custom btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit Profile
        </a>
        <form asp-action="ToggleStatus" asp-route-id="@Model.Id" method="post" class="d-inline">
            <button type="submit" class="btn btn-sm @(Model.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                @(Model.IsActive ? "Deactivate Student" : "Activate Student")
            </button>
        </form>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Directory</a>
    </div>
</div>

<!-- Primary Profile Details -->
<div class="row g-4 mb-4">
    <div class="col-lg-4">
        <div class="card card-custom h-100">
            <div class="card-header-custom">
                <span class="fw-bold"><i class="bi bi-person-badge text-primary me-2"></i> Resident Profile</span>
                <span class="badge-status @(Model.IsActive ? "badge-active" : "badge-inactive")">
                    @(Model.IsActive ? "Active" : "Inactive")
                </span>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="text-muted small fw-semibold text-uppercase">Email</label>
                    <div class="fw-bold text-dark">@Model.Email</div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small fw-semibold text-uppercase">Phone</label>
                    <div class="fw-bold text-dark">@Model.PhoneNumber</div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small fw-semibold text-uppercase">Academic Info</label>
                    <div class="fw-bold text-dark">@Model.Department (@Model.AcademicYear)</div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small fw-semibold text-uppercase">Gender & Birth Date</label>
                    <div class="fw-bold text-dark">@Model.Gender &middot; @(Model.DateOfBirth.HasValue ? Model.DateOfBirth.Value.ToString("dd MMM yyyy") : "N/A")</div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small fw-semibold text-uppercase">Blood Group & Emergency</label>
                    <div class="fw-bold text-danger"><i class="bi bi-droplet-fill me-1"></i>@(Model.BloodGroup ?? "Not specified") &middot; <span class="text-dark small">Emergency: @(Model.EmergencyContact ?? Model.GuardianContact)</span></div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small fw-semibold text-uppercase">Parent / Primary Guardian</label>
                    <div class="fw-bold text-dark">@Model.GuardianName</div>
                    <div class="small text-muted">@Model.GuardianContact</div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small fw-semibold text-uppercase">Local Guardian (LG)</label>
                    <div class="fw-bold text-purple" style="color: #7e22ce;">@(Model.LocalGuardianName ?? "Not assigned")</div>
                    <div class="small text-muted">Contact: @(Model.LocalGuardianContact ?? "N/A")</div>
                    <div class="small text-secondary">Address: @(Model.LocalGuardianAddress ?? "N/A")</div>
                </div>
                <div class="mb-0">
                    <label class="text-muted small fw-semibold text-uppercase">Permanent Home Address</label>
                    <div class="small text-secondary">@Model.Address</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Active Room Allocation Card -->
    <div class="col-lg-8">
        <div class="card card-custom h-100">
            <div class="card-header-custom">
                <span class="fw-bold"><i class="bi bi-door-open text-primary me-2"></i> Bed & Room Allocation</span>
                @if (activeAlloc != null)
                {
                    <div class="btn-group btn-group-sm">
                        <a asp-controller="Allocations" asp-action="Transfer" asp-route-id="@activeAlloc.Id" class="btn btn-outline-primary-custom py-0">Transfer Bed</a>
                        <a asp-controller="Allocations" asp-action="Vacate" asp-route-id="@activeAlloc.Id" class="btn btn-outline-danger py-0">Vacate Bed</a>
                    </div>
                }
                else
                {
                    <a asp-controller="Allocations" asp-action="Allocate" asp-route-studentId="@Model.Id" class="btn btn-sm btn-primary-custom py-0">Allocate Bed</a>
                }
            </div>
            <div class="card-body">
                @if (activeAlloc?.Bed?.Room != null)
                {
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded-3 border">
                                <small class="text-muted text-uppercase fw-semibold d-block">Hostel Block</small>
                                <span class="fs-6 fw-bold text-dark">@activeAlloc.Bed.Room.Hostel?.Name (@activeAlloc.Bed.Room.Hostel?.Code)</span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded-3 border">
                                <small class="text-muted text-uppercase fw-semibold d-block">Room Number & Floor</small>
                                <span class="fs-6 fw-bold text-dark">Room @activeAlloc.Bed.Room.RoomNumber (Floor @activeAlloc.Bed.Room.Floor)</span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded-3 border">
                                <small class="text-muted text-uppercase fw-semibold d-block">Bed Identifier</small>
                                <span class="fs-6 fw-bold text-primary">Bed @activeAlloc.Bed.BedNumber</span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded-3 border">
                                <small class="text-muted text-uppercase fw-semibold d-block">Allocation Date</small>
                                <span class="fs-6 fw-bold text-dark">@activeAlloc.AllocationDate.ToString("dd MMM yyyy")</span>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-door-closed fs-2 text-warning d-block mb-2"></i>
                        No active bed allocation for this student.
                    </div>
                }

                @if (Model.Allocations.Count > 1)
                {
                    <h6 class="small fw-bold text-muted text-uppercase mt-4 mb-2">Past Allocation History:</h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-custom small">
                            <thead>
                                <tr>
                                    <th>Bed</th>
                                    <th>Room</th>
                                    <th>Allocated</th>
                                    <th>Vacated</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in Model.Allocations.Where(a => a.Status != "Active"))
                                {
                                    <tr>
                                        <td>@a.Bed?.BedNumber</td>
                                        <td>@a.Bed?.Room?.RoomNumber</td>
                                        <td>@a.AllocationDate.ToString("dd/MM/yyyy")</td>
                                        <td>@(a.ActualVacatingDate.HasValue ? a.ActualVacatingDate.Value.ToString("dd/MM/yyyy") : "N/A")</td>
                                        <td><span class="badge bg-secondary">@a.Status</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Fee Obligations & Complaints & Leaves -->
<div class="row g-4">
    <!-- Fees -->
    <div class="col-lg-6">
        <div class="card card-custom h-100">
            <div class="card-header-custom">
                <span class="fw-bold"><i class="bi bi-wallet2 text-success me-2"></i> Fee Obligations</span>
                <a asp-controller="Fees" asp-action="AssignFee" asp-route-studentId="@Model.Id" class="btn btn-sm btn-outline-success py-0">Assign Fee</a>
            </div>
            <div class="table-responsive">
                <table class="table table-custom small">
                    <thead>
                        <tr>
                            <th>Fee</th>
                            <th>Total</th>
                            <th>Balance</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Fees.Any())
                        {
                            @foreach (var f in Model.Fees)
                            {
                                <tr>
                                    <td>@f.FeeTitle</td>
                                    <td>₹@f.TotalAmount.ToString("N0")</td>
                                    <td class="fw-bold text-danger">₹@f.BalanceAmount.ToString("N0")</td>
                                    <td><span class="badge @(f.Status == "Paid" ? "bg-success" : "bg-danger")">@f.Status</span></td>
                                    <td>
                                        @if (f.BalanceAmount > 0)
                                        {
                                            <a asp-controller="Fees" asp-action="RecordPayment" asp-route-id="@f.Id" class="btn btn-sm btn-primary-custom py-0 px-2">Pay</a>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" class="text-center text-muted py-3">No fees assigned.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Complaints & Leaves -->
    <div class="col-lg-6">
        <div class="card card-custom h-100">
            <div class="card-header-custom">
                <span class="fw-bold"><i class="bi bi-card-checklist text-primary me-2"></i> Leave & Grievance History</span>
            </div>
            <div class="card-body">
                <h6 class="small fw-bold text-muted text-uppercase mb-2">Complaints (@Model.Complaints.Count):</h6>
                @if (Model.Complaints.Any())
                {
                    <ul class="list-unstyled mb-3 small">
                        @foreach (var c in Model.Complaints.Take(3))
                        {
                            <li class="py-1 border-bottom d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="fw-semibold">@c.Subject</span>
                                    <span class="text-muted">(@c.Category)</span>
                                </div>
                                <span class="badge @(c.Status == "Resolved" ? "bg-success" : "bg-warning text-dark")">@c.Status</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="text-muted small mb-3">No complaints filed.</div>
                }

                <h6 class="small fw-bold text-muted text-uppercase mb-2">Leaves (@Model.LeaveRequests.Count):</h6>
                @if (Model.LeaveRequests.Any())
                {
                    <ul class="list-unstyled mb-0 small">
                        @foreach (var l in Model.LeaveRequests.Take(3))
                        {
                            <li class="py-1 border-bottom d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="fw-semibold">@l.StartDate.ToString("dd MMM") - @l.EndDate.ToString("dd MMM")</span>
                                    <span class="text-muted">(@l.Destination)</span>
                                </div>
                                <span class="badge @(l.Status == "Approved" ? "bg-success" : l.Status == "Rejected" ? "bg-danger" : "bg-warning text-dark")">@l.Status</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="text-muted small mb-0">No leave requests recorded.</div>
                }
            </div>
        </div>
    </div>
</div>
