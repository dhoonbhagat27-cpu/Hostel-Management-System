@model HostelEase.ViewModels.StudentEditViewModel
@{
    ViewData["Title"] = "Edit Student Profile";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-custom">
            <div class="card-header-custom">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-pencil-square text-primary fs-4"></i>
                    <div>
                        <h5 class="mb-0 fw-bold">Edit Student: @Model.FullName</h5>
                        <small class="text-muted">Update resident information and enrollment status</small>
                    </div>
                </div>
            </div>

            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="StudentId" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="StudentId" class="form-control" readonly />
                            <span asp-validation-for="StudentId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="PhoneNumber" class="form-control" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Department" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="Department" class="form-control" />
                            <span asp-validation-for="Department" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="AcademicYear" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="AcademicYear" class="form-control" />
                            <span asp-validation-for="AcademicYear" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Gender" class="form-label small fw-semibold text-secondary"></label>
                            <select asp-for="Gender" class="form-select">
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="GuardianName" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="GuardianName" class="form-control" />
                            <span asp-validation-for="GuardianName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="GuardianContact" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="GuardianContact" class="form-control" />
                            <span asp-validation-for="GuardianContact" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Address" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="Address" class="form-control" />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" />
                                <label asp-for="IsActive" class="form-check-label small fw-semibold text-secondary">Active Resident</label>
                            </div>
                        </div>

                        <div class="col-12 mt-4 d-flex gap-2">
                            <button type="submit" class="btn btn-primary-custom flex-grow-1">
                                <i class="bi bi-save me-1"></i> Save Changes
                            </button>
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
