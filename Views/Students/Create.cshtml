@model HostelEase.ViewModels.StudentCreateViewModel
@{
    ViewData["Title"] = "Register New Student (Direct Admission)";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card card-custom">
            <div class="card-header-custom">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-person-plus-fill text-purple fs-3" style="color: #7e22ce;"></i>
                    <div>
                        <h5 class="mb-0 fw-bold">Register New Student (Direct Admission)</h5>
                        <small class="text-muted">Register student names directly without requiring default self-registration</small>
                    </div>
                </div>
            </div>

            <div class="card-body p-4">
                <div class="alert alert-light border small text-muted mb-4 py-2 px-3 rounded-3" style="background-color: #faf5ff; border-color: #e9d5ff !important;">
                    <i class="bi bi-info-circle-fill text-purple me-2" style="color: #7e22ce;"></i>
                    <strong style="color: #7e22ce;">Direct Enrollment Mode:</strong> 
                    Allows administration and wardens to register new female student names immediately. If Student ID is left blank, the system automatically assigns the next available institutional enrollment number.
                </div>

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <h6 class="fw-bold text-purple border-bottom pb-2 mb-2" style="color: #7e22ce;">
                                <i class="bi bi-person-vcard me-1"></i> 1. Resident Identification
                            </h6>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="FullName" class="form-control" placeholder="e.g. Radhika Sharma" autofocus />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="StudentId" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="StudentId" class="form-control" placeholder="Leave blank to auto-generate (e.g. GH2026-005)" />
                            <span asp-validation-for="StudentId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="Email" class="form-control" placeholder="radhika@university.edu" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="+91 98765 00000" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Department" class="form-label small fw-semibold text-secondary"></label>
                            <select asp-for="Department" class="form-select">
                                <option value="">-- Choose Department --</option>
                                <option value="Computer Engineering">Computer Engineering</option>
                                <option value="Information Technology">Information Technology</option>
                                <option value="Electronics & Communication">Electronics & Communication</option>
                                <option value="Mechanical Engineering">Mechanical Engineering</option>
                                <option value="Civil Engineering">Civil Engineering</option>
                                <option value="Biotechnology">Biotechnology</option>
                            </select>
                            <span asp-validation-for="Department" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="AcademicYear" class="form-label small fw-semibold text-secondary"></label>
                            <select asp-for="AcademicYear" class="form-select">
                                <option value="">-- Choose Academic Year --</option>
                                <option value="1st Year">1st Year (Undergraduate)</option>
                                <option value="2nd Year">2nd Year (Undergraduate)</option>
                                <option value="3rd Year">3rd Year (Undergraduate)</option>
                                <option value="4th Year">4th Year (Undergraduate)</option>
                                <option value="Postgraduate / Research">Postgraduate / Research</option>
                            </select>
                            <span asp-validation-for="AcademicYear" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small fw-semibold text-secondary">Gender</label>
                            <input type="text" class="form-control bg-light" value="Female (Girls' Hostel)" readonly />
                            <input type="hidden" asp-for="Gender" value="Female" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DateOfBirth" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="DateOfBirth" type="date" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="BloodGroup" class="form-label small fw-semibold text-secondary"></label>
                            <select asp-for="BloodGroup" class="form-select">
                                <option value="">-- Select Blood Group (Optional) --</option>
                                <option value="A+">A+</option>
                                <option value="A-">A-</option>
                                <option value="B+">B+</option>
                                <option value="B-">B-</option>
                                <option value="O+">O+</option>
                                <option value="O-">O-</option>
                                <option value="AB+">AB+</option>
                                <option value="AB-">AB-</option>
                            </select>
                        </div>

                        <!-- Guardian Details -->
                        <div class="col-12 mt-4">
                            <h6 class="fw-bold text-purple border-bottom pb-2 mb-2" style="color: #7e22ce;">
                                <i class="bi bi-people-fill me-1"></i> 2. Guardian & Contact Information
                            </h6>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="GuardianName" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="GuardianName" class="form-control" placeholder="Parent Name" />
                            <span asp-validation-for="GuardianName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="GuardianContact" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="GuardianContact" class="form-control" placeholder="Parent Phone Number" />
                            <span asp-validation-for="GuardianContact" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LocalGuardianName" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="LocalGuardianName" class="form-control" placeholder="Local Guardian Name (Optional)" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LocalGuardianContact" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="LocalGuardianContact" class="form-control" placeholder="Local Guardian Phone (Optional)" />
                        </div>

                        <div class="col-12">
                            <label asp-for="Address" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="Address" class="form-control" placeholder="Permanent Residence Address" />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <!-- Direct Allocation & Password -->
                        <div class="col-12 mt-4">
                            <h6 class="fw-bold text-purple border-bottom pb-2 mb-2" style="color: #7e22ce;">
                                <i class="bi bi-door-open-fill me-1"></i> 3. Room Allocation & Authentication
                            </h6>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SelectedBedId" class="form-label small fw-semibold text-secondary"></label>
                            <select asp-for="SelectedBedId" class="form-select" asp-items="Model.AvailableBedsList">
                                <option value="">-- Do Not Allocate Bed Yet (Assign Later) --</option>
                            </select>
                            <small class="text-muted">Optionally allocate an available bed immediately.</small>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="Leave blank for default: Student@123" />
                            <small class="text-muted">Default login password is <code>Student@123</code>.</small>
                        </div>

                        <div class="col-12 mt-4 d-flex gap-2">
                            <button type="submit" class="btn btn-primary-custom flex-grow-1 py-2" style="background: linear-gradient(135deg, #7e22ce 0%, #4f46e5 100%); border: none;">
                                <i class="bi bi-person-check-fill me-1"></i> Register Student Name
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
