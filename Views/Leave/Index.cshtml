@model IEnumerable<HostelEase.Models.LeaveRequest>
@{
    ViewData["Title"] = "Leave Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Student Leave & Gate Passes</h4>
        <p class="text-muted small mb-0">Review outstation departure requests, emergency contacts, and approval statuses</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Reports" asp-action="ExportCsv" asp-route-type="leaves" class="btn btn-outline-success btn-sm">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export Leaves CSV
        </a>
    </div>
</div>

<!-- Filters -->
<div class="card card-custom p-3 mb-3">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-6">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                <input type="text" name="search" class="form-control" placeholder="Search by student name, ID, destination, or reason..." value="@ViewBag.Search" />
            </div>
        </div>
        <div class="col-md-3">
            <select name="status" class="form-select form-select-sm">
                <option value="All">All Statuses</option>
                <option value="Pending" selected="@(ViewBag.CurrentStatus == "Pending")">Pending Approval</option>
                <option value="Approved" selected="@(ViewBag.CurrentStatus == "Approved")">Approved</option>
                <option value="Rejected" selected="@(ViewBag.CurrentStatus == "Rejected")">Rejected</option>
                <option value="Cancelled" selected="@(ViewBag.CurrentStatus == "Cancelled")">Cancelled</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-sm btn-primary-custom flex-grow-1">Filter</button>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
        </div>
    </form>
</div>

<div class="card card-custom">
    <div class="table-responsive">
        <table class="table table-custom">
            <thead>
                <tr>
                    <th>Resident Student</th>
                    <th>Travel Dates</th>
                    <th>Destination</th>
                    <th>Reason</th>
                    <th>Emergency Contact</th>
                    <th>Parent Informed</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var l in Model)
                    {
                        var activeAlloc = l.Student?.Allocations.FirstOrDefault();
                        <tr>
                            <td>
                                <a asp-controller="Students" asp-action="Details" asp-route-id="@l.StudentId" class="fw-bold text-dark text-decoration-none">
                                    @l.Student?.FullName
                                </a>
                                <div class="small text-muted">
                                    @if (activeAlloc?.Bed?.Room != null)
                                    {
                                        <span>Room @activeAlloc.Bed.Room.RoomNumber (@activeAlloc.Bed.Room.Hostel?.Code)</span>
                                    }
                                    else
                                    {
                                        <span>No Active Room</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <div class="small fw-semibold text-dark">@l.StartDate.ToString("dd MMM") - @l.EndDate.ToString("dd MMM yyyy")</div>
                                <div class="small text-muted">(@((l.EndDate.Date - l.StartDate.Date).Days + 1) days)</div>
                            </td>
                            <td>@l.Destination</td>
                            <td class="small text-secondary text-truncate" style="max-width: 180px;">@l.Reason</td>
                            <td class="small font-monospace">@l.EmergencyContact</td>
                            <td>
                                <span class="badge @(l.ParentInformed ? "bg-success" : "bg-danger")">
                                    @(l.ParentInformed ? "Yes" : "No")
                                </span>
                            </td>
                            <td>
                                <span class="badge @(l.Status == "Approved" ? "bg-success" : l.Status == "Rejected" ? "bg-danger" : l.Status == "Cancelled" ? "bg-secondary" : "bg-warning text-dark")">
                                    @l.Status
                                </span>
                            </td>
                            <td>
                                <a asp-action="Review" asp-route-id="@l.Id" class="btn btn-sm btn-primary-custom py-0 px-2">
                                    @(l.Status == "Pending" ? "Review" : "Details")
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">No leave requests matching criteria.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
