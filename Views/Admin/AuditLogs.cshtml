@model IEnumerable<HostelEase.Models.AuditLog>
@{
    ViewData["Title"] = "Audit Logs";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">System Audit Trail</h4>
        <p class="text-muted small mb-0">Immutable records of all administrative allocations, financial transactions, and authentication events</p>
    </div>
</div>

<!-- Search & Action Filters -->
<div class="card card-custom mb-3 p-3">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-6">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                <input type="text" name="search" class="form-control" placeholder="Search by user email, entity, or details..." value="@ViewBag.Search" />
            </div>
        </div>
        <div class="col-md-3">
            <select name="actionType" class="form-select form-select-sm">
                <option value="">All Action Types</option>
                <option value="Login" selected="@(ViewBag.ActionType == "Login")">Login</option>
                <option value="Register" selected="@(ViewBag.ActionType == "Register")">Register</option>
                <option value="Allocate" selected="@(ViewBag.ActionType == "Allocate")">Allocate</option>
                <option value="Transfer" selected="@(ViewBag.ActionType == "Transfer")">Transfer</option>
                <option value="Vacate" selected="@(ViewBag.ActionType == "Vacate")">Vacate</option>
                <option value="Payment" selected="@(ViewBag.ActionType == "Payment")">Payment</option>
                <option value="Create" selected="@(ViewBag.ActionType == "Create")">Create</option>
                <option value="Update" selected="@(ViewBag.ActionType == "Update")">Update</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-sm btn-primary-custom flex-grow-1">Filter</button>
            <a asp-action="AuditLogs" class="btn btn-sm btn-outline-secondary">Reset</a>
        </div>
    </form>
</div>

<div class="card card-custom">
    <div class="table-responsive">
        <table class="table table-custom">
            <thead>
                <tr>
                    <th>Timestamp (UTC)</th>
                    <th>User</th>
                    <th>Action</th>
                    <th>Entity</th>
                    <th>Entity ID</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td class="small text-muted font-monospace">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td class="small fw-semibold">@(string.IsNullOrEmpty(log.UserEmail) ? "System/Anonymous" : log.UserEmail)</td>
                            <td>
                                <span class="badge @(log.Action == "Allocate" || log.Action == "Payment" ? "bg-success" : log.Action == "Vacate" || log.Action == "Delete" ? "bg-danger" : "bg-primary")">
                                    @log.Action
                                </span>
                            </td>
                            <td><span class="badge bg-light text-dark border">@log.EntityName</span></td>
                            <td class="small text-muted">@log.EntityId</td>
                            <td class="small text-secondary">@log.Details</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No audit logs matching criteria.</td></tr>
                }
            </tbody>
        </table>
    </div>

    @if (ViewBag.TotalPages > 1)
    {
        <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center py-2">
            <span class="small text-muted">Page @ViewBag.CurrentPage of @ViewBag.TotalPages</span>
            <div class="btn-group btn-group-sm">
                @if (ViewBag.CurrentPage > 1)
                {
                    <a asp-action="AuditLogs" asp-route-page="@(ViewBag.CurrentPage - 1)" asp-route-search="@ViewBag.Search" asp-route-actionType="@ViewBag.ActionType" class="btn btn-outline-secondary">Previous</a>
                }
                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <a asp-action="AuditLogs" asp-route-page="@(ViewBag.CurrentPage + 1)" asp-route-search="@ViewBag.Search" asp-route-actionType="@ViewBag.ActionType" class="btn btn-outline-secondary">Next</a>
                }
            </div>
        </div>
    }
</div>
