@model IEnumerable<HostelEase.Models.ApplicationUser>
@{
    ViewData["Title"] = "User Accounts";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">User Account Directory</h4>
        <p class="text-muted small mb-0">System authentication accounts, role assignments, and active lockouts</p>
    </div>
</div>

<div class="card card-custom">
    <div class="table-responsive">
        <table class="table table-custom">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Created On</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-bold text-dark">@u.FullName</div>
                            <div class="text-muted small">ID: @u.Id.Substring(0, Math.Min(8, u.Id.Length))...</div>
                        </td>
                        <td>@u.Email</td>
                        <td>
                            <span class="badge @(u.UserType == "Admin" ? "bg-danger" : u.UserType == "Warden" ? "bg-warning text-dark" : "bg-success")">
                                @u.UserType
                            </span>
                        </td>
                        <td class="small text-muted">@u.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td>
                            <span class="badge-status @(u.IsActive ? "badge-active" : "badge-inactive")">
                                @(u.IsActive ? "Active" : "Deactivated")
                            </span>
                        </td>
                        <td>
                            <form asp-action="ToggleUserStatus" asp-route-id="@u.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm @(u.IsActive ? "btn-outline-danger" : "btn-outline-success") py-0 px-2">
                                    @(u.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
