@model IEnumerable<HostelEase.Models.Hostel>
@{
    ViewData["Title"] = "Hostels";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Campus Hostels</h4>
        <p class="text-muted small mb-0">Residential buildings, wardens, floor capacities, and statuses</p>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary-custom btn-sm">
            <i class="bi bi-plus-circle me-1"></i> Add New Hostel
        </a>
    }
</div>

<div class="row g-4">
    @foreach (var h in Model)
    {
        var allBeds = h.Rooms.SelectMany(r => r.Beds).ToList();
        var occBeds = allBeds.Count(b => b.Status == "Occupied");
        var availBeds = allBeds.Count(b => b.Status == "Available");
        var occRate = allBeds.Count > 0 ? Math.Round(((double)occBeds / allBeds.Count) * 100, 1) : 0;

        <div class="col-lg-6">
            <div class="card card-custom h-100">
                <div class="card-header-custom">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-building-fill text-primary fs-3"></i>
                        <div>
                            <h5 class="fw-bold mb-0">@h.Name</h5>
                            <span class="badge bg-light text-primary border">@h.Code</span>
                            <span class="badge @(h.HostelType == "Boys" ? "bg-info-subtle text-info" : "bg-purple-subtle text-purple")">
                                @h.HostelType
                            </span>
                        </div>
                    </div>
                    <span class="badge @(h.Status == "Active" ? "bg-success" : "bg-secondary")">@h.Status</span>
                </div>
                <div class="card-body">
                    <p class="text-secondary small mb-3">@h.Description</p>

                    <div class="row g-3 mb-3">
                        <div class="col-6 col-sm-3">
                            <div class="p-2 border rounded-3 bg-light text-center">
                                <span class="d-block text-muted small">Floors</span>
                                <span class="fw-bold fs-6">@h.TotalFloors</span>
                            </div>
                        </div>
                        <div class="col-6 col-sm-3">
                            <div class="p-2 border rounded-3 bg-light text-center">
                                <span class="d-block text-muted small">Rooms</span>
                                <span class="fw-bold fs-6">@h.Rooms.Count</span>
                            </div>
                        </div>
                        <div class="col-6 col-sm-3">
                            <div class="p-2 border rounded-3 bg-light text-center">
                                <span class="d-block text-muted small">Total Beds</span>
                                <span class="fw-bold fs-6 text-primary">@allBeds.Count</span>
                            </div>
                        </div>
                        <div class="col-6 col-sm-3">
                            <div class="p-2 border rounded-3 bg-light text-center">
                                <span class="d-block text-muted small">Free Beds</span>
                                <span class="fw-bold fs-6 text-success">@availBeds</span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between small text-muted mb-1">
                            <span>Occupancy Rate</span>
                            <span class="fw-bold">@occRate% (@occBeds / @allBeds.Count Beds Occupied)</span>
                        </div>
                        <div class="progress" style="height: 6px;">
                            <div class="progress-bar bg-primary" role="progressbar" style="width: @occRate%"></div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center border-top pt-3 small">
                        <div>
                            <span class="text-muted">Chief Warden:</span>
                            <span class="fw-semibold">@(h.AssignedWarden?.FullName ?? "Not Assigned")</span>
                        </div>
                        <div class="btn-group btn-group-sm">
                            <a asp-action="Details" asp-route-id="@h.Id" class="btn btn-outline-primary-custom py-0">View Details</a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit" asp-route-id="@h.Id" class="btn btn-outline-secondary py-0">Edit</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
