@model HostelEase.Models.FeeStructure
@{
    ViewData["Title"] = "New Fee Structure";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card card-custom">
            <div class="card-header-custom">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-tag-fill text-primary fs-4"></i>
                    <div>
                        <h5 class="mb-0 fw-bold">Create Fee Structure Rate</h5>
                        <small class="text-muted">Define term, rent, mess fee, and deposits</small>
                    </div>
                </div>
            </div>

            <div class="card-body">
                <form asp-action="CreateStructure" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Title" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="Title" class="form-control" placeholder="e.g. Semester 2 Fee (Double Room)" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="AcademicYear" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="AcademicYear" class="form-control" value="2026-2027" />
                            <span asp-validation-for="AcademicYear" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Term" class="form-label small fw-semibold text-secondary"></label>
                            <select asp-for="Term" class="form-select">
                                <option value="Semester">Semester</option>
                                <option value="Annual">Annual</option>
                                <option value="Monthly">Monthly</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="RoomType" class="form-label small fw-semibold text-secondary"></label>
                            <select asp-for="RoomType" class="form-select">
                                <option value="Single">Single</option>
                                <option value="Double" selected>Double</option>
                                <option value="Triple">Triple</option>
                                <option value="Four-Sharing">Four-Sharing</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="HostelRent" class="form-label small fw-semibold text-secondary"></label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input asp-for="HostelRent" type="number" step="0.01" class="form-control fee-calc" id="rentInput" value="20000.00" />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MessFee" class="form-label small fw-semibold text-secondary"></label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input asp-for="MessFee" type="number" step="0.01" class="form-control fee-calc" id="messInput" value="18000.00" />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MaintenanceFee" class="form-label small fw-semibold text-secondary"></label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input asp-for="MaintenanceFee" type="number" step="0.01" class="form-control fee-calc" id="maintInput" value="4000.00" />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SecurityDeposit" class="form-label small fw-semibold text-secondary"></label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input asp-for="SecurityDeposit" type="number" step="0.01" class="form-control fee-calc" id="depositInput" value="5000.00" />
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="p-3 bg-light rounded-3 border d-flex justify-content-between align-items-center">
                                <span class="fw-bold text-dark">Calculated Total Fee:</span>
                                <span class="fw-bold fs-5 text-primary" id="totalDisplay">₹47,000.00</span>
                            </div>
                        </div>

                        <div class="col-12 mt-4 d-flex gap-2">
                            <button type="submit" class="btn btn-primary-custom flex-grow-1">Save Fee Structure</button>
                            <a asp-action="Structures" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function calcTotal() {
            const rent = parseFloat(document.getElementById('rentInput').value) || 0;
            const mess = parseFloat(document.getElementById('messInput').value) || 0;
            const maint = parseFloat(document.getElementById('maintInput').value) || 0;
            const dep = parseFloat(document.getElementById('depositInput').value) || 0;
            const total = rent + mess + maint + dep;
            document.getElementById('totalDisplay').textContent = '₹' + total.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }
        document.querySelectorAll('.fee-calc').forEach(input => {
            input.addEventListener('input', calcTotal);
        });
        calcTotal();
    </script>
}
