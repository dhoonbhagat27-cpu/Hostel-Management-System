@model HostelEase.ViewModels.RecordPaymentViewModel
@{
    ViewData["Title"] = "Record Fee Payment";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card card-custom">
            <div class="card-header-custom">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-cash-coin text-success fs-4"></i>
                    <div>
                        <h5 class="mb-0 fw-bold">Record Fee Payment</h5>
                        <small class="text-muted">Issue official payment receipt and update outstanding balance</small>
                    </div>
                </div>
            </div>

            <div class="card-body">
                <!-- Obligation Summary Banner -->
                <div class="p-3 bg-light rounded-3 border mb-4">
                    <div class="row g-2 small">
                        <div class="col-md-6"><span class="text-muted">Student:</span> <strong>@Model.StudentName (@Model.StudentIdString)</strong></div>
                        <div class="col-md-6"><span class="text-muted">Fee Title:</span> <strong>@Model.FeeTitle</strong></div>
                        <div class="col-md-4"><span class="text-muted">Total:</span> <strong>₹@Model.TotalAmount.ToString("N2")</strong></div>
                        <div class="col-md-4"><span class="text-muted">Already Paid:</span> <strong class="text-success">₹@Model.AlreadyPaidAmount.ToString("N2")</strong></div>
                        <div class="col-md-4"><span class="text-muted">Balance Due:</span> <strong class="text-danger">₹@Model.BalanceAmount.ToString("N2")</strong></div>
                    </div>
                </div>

                <form asp-action="RecordPayment" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                    <input type="hidden" asp-for="StudentFeeId" />
                    <input type="hidden" asp-for="StudentName" />
                    <input type="hidden" asp-for="StudentIdString" />
                    <input type="hidden" asp-for="FeeTitle" />
                    <input type="hidden" asp-for="TotalAmount" />
                    <input type="hidden" asp-for="AlreadyPaidAmount" />
                    <input type="hidden" asp-for="BalanceAmount" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Amount" class="form-label small fw-semibold text-secondary"></label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input asp-for="Amount" type="number" step="0.01" max="@Model.BalanceAmount" class="form-control" />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PaymentDate" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="PaymentDate" type="date" class="form-control" />
                            <span asp-validation-for="PaymentDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PaymentMethod" class="form-label small fw-semibold text-secondary"></label>
                            <select asp-for="PaymentMethod" class="form-select">
                                <option value="UPI">UPI (Google Pay / PhonePe / Paytm)</option>
                                <option value="Bank Transfer">Bank Transfer (NEFT / RTGS / IMPS)</option>
                                <option value="Cash">Cash (Hostel Accounts Desk)</option>
                                <option value="Demand Draft">Demand Draft</option>
                                <option value="Card">Debit / Credit Card</option>
                            </select>
                            <span asp-validation-for="PaymentMethod" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="TransactionReference" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="TransactionReference" class="form-control" placeholder="UTR Number, Cheque/DD No, or Cash Receipt #" />
                            <span asp-validation-for="TransactionReference" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Remarks" class="form-label small fw-semibold text-secondary"></label>
                            <textarea asp-for="Remarks" class="form-control" rows="2" placeholder="Installment note, bank branch, or verified officer remarks..."></textarea>
                        </div>

                        <div class="col-12 mt-4 d-flex gap-2">
                            <button type="submit" class="btn btn-success flex-grow-1">
                                <i class="bi bi-check-circle-fill me-1"></i> Confirm & Generate Receipt
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
