@model IEnumerable<HostelEase.Models.Room>
@{
    ViewData["Title"] = "Room & Bed Availability";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Room & Bed Availability Monitor</h4>
        <p class="text-muted small mb-0">Real-time status of every room, floor capacity, and individual bed occupancy</p>
    </div>
</div>

<div class="row g-4">
    @foreach (var room in Model)
    {
        var occupiedCount = room.Beds.Count(b => b.Status == "Occupied");
        var availableCount = room.Beds.Count(b => b.Status == "Available");
        <div class="col-md-6 col-xl-4">
            <div class="card card-custom h-100 mb-0">
                <div class="card-header-custom">
                    <div>
                        <span class="fw-bold fs-6">Room @room.RoomNumber</span>
                        <div class="text-muted small">Floor @room.Floor &middot; @room.RoomType Sharing</div>
                    </div>
                    <span class="badge-status @(room.Status == "Available" ? "badge-available" : room.Status == "Full" ? "badge-full" : "badge-maintenance")">
                        @room.Status
                    </span>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2 small">
                        <span class="text-muted">Occupancy:</span>
                        <span class="fw-bold">@occupiedCount / @room.Capacity Beds</span>
                    </div>

                    <div class="progress mb-3" style="height: 6px;">
                        <div class="progress-bar @(occupiedCount >= room.Capacity ? "bg-danger" : "bg-primary")" 
                             role="progressbar" 
                             style="width: @(room.Capacity > 0 ? (occupiedCount * 100 / room.Capacity) : 0)%">
                        </div>
                    </div>

                    <h6 class="small fw-bold text-muted text-uppercase mb-2">Beds in this Room:</h6>
                    <div class="d-flex flex-column gap-2">
                        @foreach (var bed in room.Beds.OrderBy(b => b.BedNumber))
                        {
                            var activeAlloc = bed.Allocations.FirstOrDefault(a => a.Status == "Active");
                            <div class="d-flex justify-content-between align-items-center p-2 rounded-2 border bg-light small">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-layers text-secondary"></i>
                                    <span class="fw-bold">Bed @bed.BedNumber</span>
                                </div>
                                <div>
                                    @if (activeAlloc != null)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                            Occupied by @activeAlloc.Student?.FullName
                                        </span>
                                    }
                                    else if (bed.Status == "Maintenance")
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                                            Under Maintenance
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            Available
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
