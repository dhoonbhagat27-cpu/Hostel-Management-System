@{
    ViewData["Title"] = "Password Reset Instructions";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border rounded-4 shadow-sm p-4 text-center bg-white">
                <div class="p-3 bg-success-subtle text-success rounded-circle d-inline-block mx-auto mb-3" style="width: 60px; height: 60px; display: flex; align-items: center; justify-content: center;">
                    <i class="bi bi-envelope-check-fill fs-3"></i>
                </div>
                <h4 class="fw-bold mb-2">Instructions Sent</h4>
                <p class="text-secondary small mb-4">
                    If the email matches an active account in our database, password reset instructions have been generated.
                </p>

                @if (TempData["ResetLink"] != null)
                {
                    <div class="alert alert-info text-start small mb-4">
                        <strong><i class="bi bi-info-circle me-1"></i> Development Reset Link:</strong><br/>
                        <a href="@TempData["ResetLink"]" class="text-break mt-1 d-inline-block">Click here to set new password</a>
                    </div>
                }

                <a asp-action="Login" class="btn btn-primary-custom px-4">
                    Return to Login
                </a>
            </div>
        </div>
    </div>
</div>
