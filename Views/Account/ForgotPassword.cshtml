@model HostelEase.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border rounded-4 shadow-sm p-4 bg-white">
                <div class="text-center mb-4">
                    <div class="p-3 bg-primary-subtle text-primary rounded-circle d-inline-block mb-2" style="width: 56px; height: 56px; display: inline-flex; align-items: center; justify-content: center;">
                        <i class="bi bi-key-fill fs-3"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-1">Reset Password</h4>
                    <p class="text-muted small">Enter your registered email address to receive password recovery instructions</p>
                </div>

                <form asp-action="ForgotPassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold text-secondary"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="name@hostelease.com" autofocus />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary-custom w-100 py-2 mb-3">
                        Send Recovery Instructions
                    </button>
                </form>

                <div class="text-center border-top pt-3">
                    <a asp-action="Login" class="text-primary small fw-semibold text-decoration-none">
                        <i class="bi bi-arrow-left me-1"></i> Back to Sign In
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
