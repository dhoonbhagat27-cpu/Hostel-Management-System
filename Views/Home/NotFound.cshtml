@{
    ViewData["Title"] = "Page Not Found";
}

<div class="container py-5 text-center">
    <div class="py-5">
        <div class="display-1 fw-bold text-primary mb-3">404</div>
        <h3 class="fw-bold mb-2">Page Not Found</h3>
        <p class="text-secondary mb-4">The page or resource you requested could not be located on the server.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary-custom px-4">
            <i class="bi bi-house-door-fill me-1"></i> Return to Home
        </a>
    </div>
</div>
