@{
    ViewData["Title"] = "Security & Helpdesk - Girls' Hostel";
}

<div class="container py-5">
    <div class="text-center max-w-2xl mx-auto mb-5">
        <span class="badge bg-purple-subtle text-purple border px-3 py-1 rounded-pill fw-semibold mb-2" style="background-color: #f3e8ff; color: #7e22ce; border-color: #d8b4fe !important;">
            <i class="bi bi-shield-heart-fill me-1"></i> Women's Campus Support & Security
        </span>
        <h2 class="fw-bold display-6">Girls' Hostel Administration & Helpdesk</h2>
        <p class="text-secondary">Reach out to our dedicated resident wardens, female security gate supervisors, or health desk for assistance.</p>
    </div>

    <div class="row g-4 justify-content-center">
        <div class="col-md-4">
            <div class="card h-100 border rounded-4 p-4 shadow-sm bg-white text-center">
                <div class="p-3 bg-purple-subtle text-purple rounded-circle mx-auto mb-3" style="width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; background-color: #f3e8ff; color: #7e22ce;">
                    <i class="bi bi-geo-alt-fill fs-4"></i>
                </div>
                <h5 class="fw-bold mb-2">Campus Location</h5>
                <p class="text-secondary small mb-0">
                    Women's Residential Enclave, Gate 2,<br/>
                    Adjacent to Kalpana Chawla & Kasturba Halls,<br/>
                    Engineering University Campus
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border rounded-4 p-4 shadow-sm bg-white text-center">
                <div class="p-3 bg-danger-subtle text-danger rounded-circle mx-auto mb-3" style="width: 60px; height: 60px; display: flex; align-items: center; justify-content: center;">
                    <i class="bi bi-telephone-fill fs-4"></i>
                </div>
                <h5 class="fw-bold mb-2">24/7 Emergency & Wardens</h5>
                <p class="text-secondary small mb-0">
                    Chief Warden Desk: +91 98111 22233<br/>
                    Resident Warden: +91 98222 33344<br/>
                    Women's Security Gate: +91 98765 43210<br/>
                    Campus Health Infirmary: +91 98765 43219
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border rounded-4 p-4 shadow-sm bg-white text-center">
                <div class="p-3 bg-info-subtle text-info rounded-circle mx-auto mb-3" style="width: 60px; height: 60px; display: flex; align-items: center; justify-content: center;">
                    <i class="bi bi-envelope-fill fs-4"></i>
                </div>
                <h5 class="fw-bold mb-2">Official Email Contacts</h5>
                <p class="text-secondary small mb-0">
                    warden.sarojini@hostelease.com<br/>
                    warden.kalpana@hostelease.com<br/>
                    admin@hostelease.com<br/>
                    safety@hostelease.com
                </p>
            </div>
        </div>
    </div>
</div>
