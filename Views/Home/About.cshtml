                            <i class="bi bi-building-fill fs-3" style="color: #7e22ce;"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-0">Sarojini Naidu Hall (Block B)</h6>
                            <span class="badge bg-purple-subtle text-purple" style="background-color: #f3e8ff; color: #7e22ce;">Postgraduate & Research</span>
