@{
    ViewData["Title"] = "About Us - Girls' Hostel";
}

<div class="container py-5">
    <div class="row align-items-center gy-4 mb-5">
        <div class="col-lg-6">
            <span class="badge bg-purple-subtle text-purple border px-3 py-1 rounded-pill fw-semibold mb-2" style="background-color: #f3e8ff; color: #7e22ce; border-color: #d8b4fe !important;">
                <i class="bi bi-shield-heart-fill me-1"></i> Women's Residential Campus System
            </span>
            <h2 class="fw-bold display-6 mb-3">About <span class="text-purple" style="color: #7e22ce;">HostelEase</span></h2>
            <p class="text-secondary leading-relaxed mb-3">
                <strong>HostelEase</strong> is an enterprise-grade Girls' Hostel Management Information System engineered as a Final-Year B.Tech Computer Engineering Capstone Project. Traditional residential campuses struggle with paper night registers, late-curfew logging vulnerabilities, manual visitor gatebooks, and delayed grievance resolution.
            </p>
            <p class="text-secondary leading-relaxed">
                Our objective is to create a secure, transparent, and dignified living environment for female students and researchers. By integrating 8:30 PM biometric evening curfew monitoring, verified Local Guardian (LG) protocols, digital outstation leave workflows with parental consent, and emergency medical infirmary linkage, HostelEase provides complete peace of mind to students, parents, and university administration.
            </p>
        </div>
        <div class="col-lg-6">
            <div class="card border rounded-4 p-4 shadow-sm bg-white">
                <h5 class="fw-bold mb-3 border-bottom pb-2 text-purple" style="color: #7e22ce;">
                    <i class="bi bi-mortarboard-fill me-2"></i> Capstone Project Specifications
                </h5>
                <ul class="list-unstyled mb-0 small">
                    <li class="py-2 border-bottom d-flex justify-content-between">
                        <span class="text-muted">Degree / Course:</span>
                        <span class="fw-semibold">B.Tech Computer Engineering</span>
                    </li>
                    <li class="py-2 border-bottom d-flex justify-content-between">
                        <span class="text-muted">Project Domain:</span>
                        <span class="fw-semibold">Girls' Hostel Residential Security & Management</span>
                    </li>
                    <li class="py-2 border-bottom d-flex justify-content-between">
                        <span class="text-muted">Technology Framework:</span>
                        <span class="fw-semibold">ASP.NET Core MVC (C#) & .NET 10</span>
                    </li>
                    <li class="py-2 border-bottom d-flex justify-content-between">
                        <span class="text-muted">ORM & Database:</span>
                        <span class="fw-semibold">EF Core Code-First & Microsoft SQL Server</span>
                    </li>
                    <li class="py-2 border-bottom d-flex justify-content-between">
                        <span class="text-muted">Security Architecture:</span>
                        <span class="fw-semibold">ASP.NET Core Identity & Role-Based RBAC</span>
                    </li>
                    <li class="py-2 d-flex justify-content-between">
                        <span class="text-muted">Presentation & Analytics:</span>
                        <span class="fw-semibold">Bootstrap 5, Chart.js & Bootstrap Icons</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Campus Hostels Profile -->
    <div class="mb-5">
