@{
    ViewData["Title"] = "Campus Living Amenities & Features";
}

<div class="container py-5">
    <div class="text-center max-w-2xl mx-auto mb-5">
        <span class="badge bg-purple-subtle text-purple border px-3 py-1 rounded-pill fw-semibold mb-2" style="background-color: #f3e8ff; color: #7e22ce; border-color: #d8b4fe !important;">
            <i class="bi bi-shield-heart-fill me-1"></i> Women's Campus Capabilities
        </span>
        <h2 class="fw-bold display-6">Engineered for Resident Safety & Academic Excellence</h2>
        <p class="text-secondary">HostelEase delivers a full suite of security, digital gate pass, student living, and supervisory tools designed for girls' residential campuses.</p>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border rounded-4 p-4 shadow-sm bg-white">
                <div class="p-3 bg-purple-subtle text-purple rounded-3 d-inline-block mb-3" style="width: fit-content; background-color: #f3e8ff; color: #7e22ce;">
                    <i class="bi bi-shield-lock-fill fs-3"></i>
                </div>
                <h5 class="fw-bold mb-2">Strict Female Resident Access & RBAC</h5>
                <p class="text-secondary small mb-0">
                    Fine-grained role division between Admin, Chief Warden, and Student. Public registration is restricted to verified female students with Local Guardian credentials, preventing unauthorized access.
                </p>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border rounded-4 p-4 shadow-sm bg-white">
                <div class="p-3 bg-danger-subtle text-danger rounded-3 d-inline-block mb-3" style="width: fit-content;">
                    <i class="bi bi-clock-history fs-3"></i>
                </div>
                <h5 class="fw-bold mb-2">8:30 PM Curfew & Evening Roll-Call</h5>
                <p class="text-secondary small mb-0">
                    Evening attendance monitoring at entrance consoles. Absent resident lists are instantly compiled for resident wardens, and automated alert logs maintain gate discipline.
                </p>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border rounded-4 p-4 shadow-sm bg-white">
                <div class="p-3 bg-info-subtle text-info rounded-3 d-inline-block mb-3" style="width: fit-content;">
                    <i class="bi bi-envelope-check-fill fs-3"></i>
                </div>
                <h5 class="fw-bold mb-2">Parent-Verified Outstation Leave Pass</h5>
                <p class="text-secondary small mb-0">
                    Online leave requests for weekend home visits or academic conferences. Destination, departure/return dates, and parental phone authorization are verified prior to digital pass approval.
                </p>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border rounded-4 p-4 shadow-sm bg-white">
                <div class="p-3 bg-warning-subtle text-warning rounded-3 d-inline-block mb-3" style="width: fit-content;">
                    <i class="bi bi-person-lines-fill fs-3"></i>
                </div>
                <h5 class="fw-bold mb-2">Authorized Visitor Lounge Protocol</h5>
                <p class="text-secondary small mb-0">
                    Digital gate register strictly limits visitor entry to approved parents and registered Local Guardians (LGs). Time in, time out, and government photo IDs are logged in the security ledger.
                </p>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border rounded-4 p-4 shadow-sm bg-white">
                <div class="p-3 bg-success-subtle text-success rounded-3 d-inline-block mb-3" style="width: fit-content;">
                    <i class="bi bi-grid-3x3-gap-fill fs-3"></i>
                </div>
                <h5 class="fw-bold mb-2">Granular Bed Allocation & Concurrency</h5>
                <p class="text-secondary small mb-0">
                    Hostel &rarr; Floor &rarr; Room &rarr; Bed relational schema with database rowversion concurrency tokens, preventing double bed allocations and over-capacity room assignments.
                </p>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border rounded-4 p-4 shadow-sm bg-white">
                <div class="p-3 bg-primary-subtle text-primary rounded-3 d-inline-block mb-3" style="width: fit-content;">
                    <i class="bi bi-tools fs-3"></i>
                </div>
                <h5 class="fw-bold mb-2">Hygiene, Maintenance & Infirmary</h5>
                <p class="text-secondary small mb-0">
                    Ticketing workflow for electrical, hot-water geyser, high-speed Wi-Fi, and sanitary pad disposal maintenance. Wardens triage tickets with immediate technician dispatch.
                </p>
            </div>
        </div>
    </div>
</div>
